    (property "Class" "150V 20A ultrafast" (id 5) (at 672.54 63.92 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Chosen" "Vishay FRED Pt, 200 V, 16 A avg, 250 A surge, trr 32 ns, AEC-Q101. SMPD (TO-263AC), cathode on the tab -- no KiCad 7 footprint, drawn in phase 3" (id 6) (at 672.54 63.92 0)
