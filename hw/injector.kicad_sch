      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "The charger regulates from BELOW only -- 50 mA while the rail is under setpoint, nothing above it. Without this resistor ANY excursion above 100 V is permanent: three hold-cutoff recirculation events stack to 106.4 V and stay there." (id 5) (at 120.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Sizing" "one 100 uC event is 2.14 V on 47 uF; above setpoint the charger is off so the whole 4.55 mA discharges it in 21.4 ms, against 26.67 ms between cylinders" (id 6) (at 120.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Cost" "455 mW burned continuously whenever the rail is up" (id 7) (at 120.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
