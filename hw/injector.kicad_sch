    (property "Datasheet" "~" (id 3) (at 80.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Source" "boost_converter.cir Ca" (id 4) (at 80.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "The converter cannot deliver 18 A -- it delivers a trickle and this capacitor delivers the pulse. 342 uC per peak phase gives 7.3 V of droop, so the rail sags to 92.7 V. Its job is to be much larger than 13.5 V, not to be exactly 100 V." (id 5) (at 80.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Vr" "150 V class: 100 V setpoint plus the recirculation bump, same margin logic transient_clamp used" (id 6) (at 80.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
  )
