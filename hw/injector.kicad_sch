  (text "GATE_KILL reaches the four high sides at the drivers' HIN inputs, not at the gates -- a ground-referenced kill FET cannot short a gate\nfloating 100 V up, but HIN is ground-referenced. See the gate-driver block on the right." (at 150.0 128.0 0)
    (effects (font (size 1.6 1.6)) (justify left))
    (uuid f0468d5f-3fda-44c7-9c39-d6d3cd4f70f5)
