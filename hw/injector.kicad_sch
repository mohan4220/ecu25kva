      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Pass transistor. Nexperia PZTA42-Q: 300 V, 100 mA, AEC-Q101, SOT223, 104 K/W, Tj 150 C. Alone it would carry 88 V x 5 mA = 0.44 W, and 1.16 W into a short -- over the 0.43 W it may dissipate at a 105 C board. The collector resistors take half: 0.27 W normal, 0.24 W shorted." (id 5) (at 760.0 382.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Pins" "SOT223 is B-C-E with the collector on the tab, which is this symbol's numbering" (id 6) (at 760.0 382.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
  )
