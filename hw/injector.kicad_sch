      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Datasheet" "~" (id 3) (at 660.0 172.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Source" "Infineon AUIRS2181(4)S datasheet, 10 Jan 2014 -- 'Piezo / common rail Injection' is its first listed application" (id 4) (at 660.0 172.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "HO drives HSA_BOOST_GATE, referenced to INJ_A_03. LO drives LS1_GATE." (id 5) (at 660.0 172.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Why" "NO cross-conduction interlock: the high and low switches here are in SERIES with the coil and must both be on to fire it" (id 6) (at 660.0 172.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
  )
