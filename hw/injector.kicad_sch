    (property "Chosen" "Wurth WE-PD 1210, 150 uH, IR 2.1 A, Isat 2.7 A (10%) / 3.3 A (30%) typ, 200 mOhm max, 120 V, AEC-Q200 Grade 1. Same land pattern as 7447709220 (2.9 x 5.4 pads, 7.0 gap). Decisions log 8" (id 6) (at 115.0 455.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Source" "run_sim boost_converter, BOOST-SLOPE -- decisions log 2b and 8" (id 7) (at 115.0 455.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "150 uH, not the 330 uH first drawn (no SMD part) or the 100 uH first approved (too little stability margin). With 62 mOhm sense the current limit is 1.94-2.90 A: 7% past the 10% saturation point, 14% under the 30% point, in a fault only." (id 8) (at 115.0 455.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "DCR" "200 mOhm max -- 0.2 W at the 1 A cranking corner" (id 9) (at 115.0 455.0 0)
