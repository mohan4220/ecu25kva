      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Chosen" "Chemi-Con HXC hybrid polymer, 82 uF, 80 V, 10 x 12.5 mm, 28 mOhm max, Z(-55)/Z(20) <= 2 at 100 kHz, 2.1 A rms at 125 C, 4000 h at 125 C, AEC-Q200. Two in series: 41 uF, 160 V" (id 6) (at 80.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Source" "boost_converter.cir Ca; decisions log 9" (id 7) (at 80.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "TOP of a two-can stack with C420 -- 41 uF, 160 V. The converter cannot deliver 18 A; it delivers a trickle and this stack delivers the pulse. 342 uC per peak phase gives 8.3 V of droop, 14.9 V on the smallest aged stack." (id 8) (at 80.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Why two" "No capacitor rated above 100 V publishes a cold ESR. These do: 28 mOhm max, at most 2x at -55 C. Stack worst 224 mOhm aged and cold -- 18 A in 45 us, against 38 us nominal." (id 9) (at 80.0 68.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
  )
