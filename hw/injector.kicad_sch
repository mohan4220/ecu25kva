    (property "Source" "sized here -- boost_converter.cir models the converter as an average current and has no inductor" (id 4) (at 115.0 455.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "At 150 kHz and 13.5 V in, ripple is 0.24 A on a 0.44 A average -- continuous conduction with room. Saturation rating is set by the current limit above it, not by the operating current: 82 mOhm sense against a 120-180 mV threshold trips somewhere in 1.46-2.20 A." (id 5) (at 115.0 455.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "DCR" "<=0.2 ohm -- 0.2 W at the 1 A cranking corner" (id 6) (at 115.0 455.0 0)
