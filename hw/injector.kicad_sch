    )
    (property "Chosen" "Vishay FRED Pt, 200 V, 16 A avg, 250 A surge, trr 32 ns, AEC-Q101. SMPD (TO-263AC), cathode on the tab -- no KiCad 7 footprint, drawn in phase 3" (id 6) (at 486.54 156.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Source" "injector_turnoff.cir Drc -- the diode memo 10 recommends and the one this block exists to add" (id 7) (at 486.54 156.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Low side back into the boost reservoir. NOT a Zener active clamp across the FET (Nexperia AN50003 rates repetitive active clamp reliability-'Questionable', gate-oxide wear-out) and NOT a freewheel to battery (too slow -- the same problem the boost rail exists to fix on the opening side)." (id 8) (at 486.54 156.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Peak" "28.7 W instantaneous during turn-off, ~8x the 3.6 W average across all 9 events/second -- the pulse sizes this part, the average never would" (id 9) (at 486.54 156.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
