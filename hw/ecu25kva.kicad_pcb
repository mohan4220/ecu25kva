		(property "Pins" "SOT-23 bipolar order is B-E-C, hence the BEC symbol. 40 V: it never sees more than the ~13 V between the pass base and the output"
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "fc34aa13-7d18-4dab-9afa-90004c2475a7")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "Current limit. Conducts when the drop across the 56 ohm reaches one Vbe -- 0.65 V / 56 = 11.6 mA -- and steals the pass transistor's base drive. Without it a shorted 12V_GATE gets hFE x the full bias current from a 100 V rail."
			(at 0 0 0)
			(layer "F.SilkS")
