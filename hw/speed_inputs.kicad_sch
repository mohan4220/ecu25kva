  (symbol (lib_id "Device:R") (at 130.0 56.0 0) (unit 1)
    (in_bom yes) (on_board yes) (fields_autoplaced)
    (uuid 9bf89065-b695-4ae0-b5ec-789fc28c1a60)
    (property "Reference" "R703" (id 0) (at 130.0 50.92 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Value" "100k" (id 1) (at 130.0 61.08 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (id 2) (at 130.0 56.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Datasheet" "~" (id 3) (at 130.0 56.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "MATCHED to the LO leg's 100k. With the sensor disconnected both legs sit at VR_BIAS, the two inputs are equal, and the comparator stays latched where the hysteresis left it -- no edges at all, which is the correct shape for a lost-sensor fault: the MCU sees loss of speed rather than a plausible wrong speed." (id 4) (at 130.0 56.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
  )
