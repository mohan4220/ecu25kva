    (property "Value" "4.7k" (id 1) (at 85.0 120.08 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (id 2) (at 85.0 115.0 0)
