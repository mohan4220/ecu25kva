    (property "Tag" "VR-CLAMP" (id 7) (at 62.0 92.5 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Bidirectional, across the pair. Standoff has to clear the signal itself: VR amplitude is proportional to speed, about 20 V peak at 1500 rpm, so a part that clamps at 24 V would clip a runaway engine's own crank signal -- the one time the ECU most needs to keep counting teeth. 48 V clears 3600 rpm." (id 8) (at 62.0 92.5 0)
      (effects (font (size 1.27 1.27)) hide)
    )
