  (symbol (lib_id "Device:R") (at 130.0 56.0 0) (unit 1)
    (in_bom yes) (on_board yes) (fields_autoplaced)
    (uuid ece46800-2786-4c51-afbf-2f3b1dd34044)
    (property "Reference" "R3" (id 0) (at 130.0 50.92 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Value" "100k" (id 1) (at 130.0 61.08 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Footprint" "" (id 2) (at 130.0 56.0 0)
