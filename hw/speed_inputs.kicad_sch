  (symbol (lib_id "Device:R") (at 60.0 181.0 0) (unit 1)
    (in_bom yes) (on_board yes) (fields_autoplaced)
    (uuid f49c16d5-92ca-4b09-9ec6-08b194f271c7)
    (property "Reference" "R706" (id 0) (at 60.0 175.92 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Value" "2.2k" (id 1) (at 60.0 186.08 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (id 2) (at 60.0 181.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Datasheet" "~" (id 3) (at 60.0 181.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "2.2k/2.2k, not 10k/10k. The feedback resistor's current (about 44 uA) returns into this node, and 10k/10k's 5k source impedance would move VR_BIAS 220 mV when the output switches -- comparable to the whole hysteresis window. It is a COMMON-MODE shift, so it cancels in the comparison, but it is not worth relying on cancellation for 0.75 mA of quiescent current." (id 4) (at 60.0 181.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
  )
