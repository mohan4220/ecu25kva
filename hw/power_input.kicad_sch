  (hierarchical_label "VBAT_EGR" (shape output) (at 340.0 360.0 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 82c91d5e-faba-5958-8ab2-148b703635f3)
  )
  (text "GATE DRIVE -- both power-path gates are driven:\\n  VBAT_REV_GATE   Q1 is a P-FET: 47k gate to ground, zener gate-to-source. No controller needed.\\n  NCLAMP_GATE     Q2 (negative clamp): TLV3201-Q1 comparator into a UCC27517A-Q1 driver.\\n                  Engage below -100 mV, release above -5 mV (see neg_clamp_control).\\nKeep U102 at Q2's gate with a short return to Q2's source: the clamp's speed is the gate loop's." (at 30.0 150.0 0)
    (effects (font (size 1.6 1.6)) (justify left))
    (uuid 870b8f81-5651-5960-ad1c-fe1e45987814)
  )
  (text "Stage order is spec sec.4: EMI filter -> fuse -> TVS -> reverse-battery FET -> buck VIN.\\nEMI filter values are emi_filter.cir element for element. Every part carries its source in a hidden Source field." (at 30.0 175.0 0)
    (effects (font (size 1.6 1.6)) (justify left))
    (uuid a4752cc5-bec3-5816-97f3-f21b355c04cc)
  )
  (sheet_instances
    (path "/" (page "1"))
  )
