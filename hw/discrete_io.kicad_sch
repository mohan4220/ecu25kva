    (property "Chosen" "Vishay TransZorb, 48 V standoff, VBR 53.3-58.9 V, 400 W, AEC-Q101" (id 6) (at 128.0 271.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Source" "main_relay.cir part C" (id 7) (at 128.0 271.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Replaces the flyback diode to VBAT_PROT, which made a sneak path: coil on Term. 30, diode into the board, 22.8 mA through the coil with the relay OFF (2.7x its release current) and the board at 9.1 V. Bosch: pin 50 has no freewheeling diode; it belongs in the relay." (id 8) (at 128.0 271.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Rating" "48 V standoff clears the 40 V clamped dump; 53-59 V peak at turn-off against the FET's 100 V; 4.9 mJ per release" (id 9) (at 128.0 271.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Rotation" "bidirectional -- orientation not significant" (id 10) (at 128.0 271.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
