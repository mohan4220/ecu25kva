      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Note" "Bank A, cylinders 1 and 3 sharing one return. They fire 240 crank degrees apart, so only one is ever conducting and the shared shunt is unambiguous -- the same fact that lets the high side be bank-shared." (id 5) (at 200.0 260.0 0)
      (effects (font (size 1.27 1.27)) hide)
    )
    (property "Signal" "90 mV at the 18 A peak, 50 mV at the 10 A hold -- too small for the ADC directly, so the amplifier is not optional" (id 6) (at 200.0 260.0 0)
      (effects (font (size 1.27 1.27)) hide)
