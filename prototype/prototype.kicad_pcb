		(property "Source" "supervisor.cir -- the kill FET, moved to the driver's logic input"
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "6d5403dd-aeff-4c96-a760-436300373c00")
			(effects
